{
  "permissions": {
    "defaultMode": "auto"
  },
  "statusLine": {
    "type": "command",
    "command": "sh /Users/ankan/.claude/statusline-command.sh"
  },
  "enabledPlugins": {
    "slack@claude-plugins-official": true,
    "claude-obsidian@agricidaniel-claude-obsidian": true,
    "vercel@claude-plugins-official": false,
    "frontend-design@claude-plugins-official": true,
    "superpowers@claude-plugins-official": true,
    "skill-creator@claude-plugins-official": true,
    "gws@gws-local": false
  },
  "extraKnownMarketplaces": {
    "anthropic-agent-skills": {
      "source": {
        "source": "github",
        "repo": "anthropics/skills"
      }
    },
    "gws-local": {
      "source": {
        "source": "directory",
        "path": "/Users/ankan/.claude/gws-local"
      }
    }
  },
  "editorMode": "normal",
  "autoCompactEnabled": false,
  "env": {
    "BASH_MAX_OUTPUT_LENGTH": "200000"
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "^(Bash|mcp__.*)$",
        "hooks": [
          {
            "type": "command",
            "command": "python3 ~/.claude/hooks/compress_hook.py",
            "timeout": 120
          }
        ]
      }
    ]
  }
}
