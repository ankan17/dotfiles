{
  "permissions": {
    "defaultMode": "auto"
  },
  "model": "opus[1m]",
  "statusLine": {
    "type": "command",
    "command": "sh /Users/ankan/.claude/statusline-command.sh"
  },
  "enabledPlugins": {
    "slack@claude-plugins-official": true,
    "claude-obsidian@agricidaniel-claude-obsidian": true,
    "vercel@claude-plugins-official": false,
    "frontend-design@claude-plugins-official": true,
    "skill-creator@claude-plugins-official": true,
    "gws@gws-local": false,
    "superpowers@superpowers-marketplace": true,
    "ponytail@ponytail": true,
    "codex@openai-codex": true
  },
  "extraKnownMarketplaces": {
    "anthropic-agent-skills": {
      "source": {
        "source": "github",
        "repo": "anthropics/skills"
      }
    },
    "gws-local": {
      "source": {
        "source": "directory",
        "path": "/Users/ankan/.claude/gws-local"
      }
    },
    "superpowers-marketplace": {
      "source": {
        "source": "github",
        "repo": "obra/superpowers-marketplace"
      }
    },
    "ponytail": {
      "source": {
        "source": "github",
        "repo": "DietrichGebert/ponytail"
      }
    },
    "openai-codex": {
      "source": {
        "source": "github",
        "repo": "openai/codex-plugin-cc"
      }
    }
  },
  "tui": "default",
  "voice": {
    "enabled": false,
    "mode": "hold"
  },
  "theme": "dark",
  "editorMode": "normal",
  "autoCompactEnabled": false,
  "agentPushNotifEnabled": true,
  "voiceEnabled": false,
  "env": {
    "BASH_MAX_OUTPUT_LENGTH": "200000"
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "^(Bash|mcp__.*)$",
        "hooks": [
          {
            "type": "command",
            "command": "python3 ~/.claude/hooks/compress_hook.py",
            "timeout": 120
          }
        ]
      }
    ]
  }
}
